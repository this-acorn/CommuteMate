# ============================================================
# CommuteMate — Git ignore rules
# ============================================================

# ---------- Maven / Java build output ----------
/target/
**/target/
*.class

# Maven Wrapper downloads this file when needed.
# Keep mvnw, mvnw.cmd, and .mvn/wrapper/maven-wrapper.properties in Git.
.mvn/wrapper/maven-wrapper.jar

# Spring Initializr helper file (README.md is used instead)
HELP.md

# ---------- Local H2 database ----------
# Generated by jdbc:h2:file:./data/commutemate
/data/
*.mv.db
*.trace.db
*.lock.db

# ---------- Node / Tailwind dependencies ----------
/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ---------- Environment variables and local secrets ----------
.env
.env.*
!.env.example

# Local-only Spring configuration
src/main/resources/application-local.properties
src/main/resources/application-secrets.properties

# ---------- Logs, temporary files, and process files ----------
*.log
/logs/
*.tmp
*.temp
*.pid
*.swp
*.swo
*~

# ---------- IntelliJ IDEA ----------
.idea/
*.iws
*.iml
*.ipr

# ---------- Eclipse / Spring Tool Suite ----------
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# ---------- VS Code ----------
.vscode/

# ---------- NetBeans ----------
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
/build/

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
__MACOSX/

# ---------- Windows ----------
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ---------- Linux ----------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------- Local archives / exported project copies ----------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ---------- Test and coverage reports outside target ----------
/coverage/
/.nyc_output/

# ---------- Tool caches ----------
.cache/
.parcel-cache/
